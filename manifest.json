{
  "manifest_version": 3,
  "name": "Utah Job Contact Filler",
  "version": "1.4.1",
  "description": "Import JSON or CSV job-search contacts and fill Utah DWS Job Contacts.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://jobs.utah.gov/ui/home/weeklyclaims/WeeklyFiling*"
  ],
  "action": {
    "default_title": "Utah Job Contact Filler",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://jobs.utah.gov/ui/home/weeklyclaims/WeeklyFiling*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
